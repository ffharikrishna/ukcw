# Public URL of the site, used for share images.
NEXT_PUBLIC_SITE_URL=https://ukcw.example.com

# Discord invite used for every "Join" button and for the live member count.
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite

# Shared secret the Discord bot sends when posting session updates to /api/session.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_WEBHOOK_SECRET=

# Optional: ER:LC private server key (in-game: Settings > Private Server > API).
# Adds real player counts and the join code to the status panel.
ERLC_SERVER_KEY=
# Player count at which the site treats the server as "in session" without a bot announcement.
ERLC_ACTIVE_THRESHOLD=5

# A live session with no update for this many hours is shown as offline.
SESSION_STALE_HOURS=6

# Storage for session state. Required on Vercel/serverless so updates survive between requests.
# Either Vercel KV names or Upstash names work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
